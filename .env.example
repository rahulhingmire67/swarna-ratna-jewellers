# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://admin:password@cluster0.mongodb.net/jewellery_shop?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jewellery_db?retryWrites=true&w=majority

# Production Server Port (Default: 5000)
PORT=5000
